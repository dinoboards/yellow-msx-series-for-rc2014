CHRFLN	EQU	"&"
CHRVLN	EQU	"@"
	ENDIF

	IF	(BASVER EQ 1) AND (CNTRY NE 3)
CHRCUR	EQU	"$"
CHRFLN	EQU	"\"
CHRVLN	EQU	"&"
	ENDIF

	IF	(BASVER EQ 1) AND (CNTRY EQ 3)

