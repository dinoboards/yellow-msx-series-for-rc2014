Name     turbo-cpu-mwait ;
PartNo   00 ;
Date     15/12/2020 ;
Revision 01 ;
Designer Dean Netherton ;
Company  Dino ;
Assembly None ;
Location Ignored ;
Device   g16v8a ;


/************* INPUT PINS *********************/
PIN  1 = CPU_CLK;
PIN  2 = !M1;
PIN  3 = !MREQ;
PIN  4 = !BWAIT;
PIN  5 = !MODE_FAST;
PIN  6 = !RFSH;
PIN  7 = !IORQ;
PIN  8 = !MODE_NORMAL;
//PIN  9 = NC
PIN 10 = GND;
//PIN 11 = ;

/**************** OUTPUT PINS *********************/
PIN 12 = T2;
PIN 13 = T3;
PIN 14 = T4;
PIN 15 = T1;
PIN 16 = !CWAIT;
PIN 17 = T6;
PIN 18 = ACTIVE;
PIN 19 = T5;
PIN 20 = VCC;

/*
1. ALWAYS WHEN BWAIT (BUS WAIT) IS LOW, THEN CWAIT (CPU WAIT) IS LOW

FOR MODE_NORMAL:
1. ONE WAIT STATE WHEN M1 IS TRUE AND MREQ IS TRUE (M1 WAIT STATE GENERATOR)

FOR MODE_FAST:
1. ONE WAIT STATE WHEN MREQ & !RFSH
2. ONE WAIT STATE WHEN IORQ

FOR MODE_MIDDLE:
1. THREE WAIT STATE WHEN MREQ & !RFSH
2. THREE WAIT STATE WHEN IORQ

*/


MODE_MIDDLE=!MODE_NORMAL & !MODE_FAST;

WAIT_REQ = (MODE_NORMAL & MREQ & !RFSH & M1) # (!MODE_NORMAL & MREQ & !RFSH) # (!MODE_NORMAL & IORQ);

T0 = WAIT_REQ & !T1 & !ACTIVE & !T5;
_T1 = T1 & !T2;
_T2 = T2 & !T3 & MODE_MIDDLE;
_T3 = T3 & !T4;
_T4 = (T4 # (!MODE_MIDDLE & T2));  /* IF NOT MODE_MIDDLE, THERE IS NO T2..T3) */
_T5 = T5 & !T6;

ACTIVE.D = T0 # _T1 # _T2 # _T3; /*ACTIVE IS TRUE, WHEN IN T1, T2, T3 OR T4) */

T1.D = T0;
T2.D = _T1;
T3.D = _T2;
T4.D = _T3;
T5.D = _T4;
T6.D = _T5;

CWAIT = BWAIT # ACTIVE # (T0 & !T6);

